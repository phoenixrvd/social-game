{
  "scripts": {
    "build": "npm run generate:api && vite build",
    "build:static": "vite build",
    "watch": "vite build --watch",
    "dev": "vite",
    "format": "prettier --write \"engine/web/react/**/*.{ts,tsx}\" \"!engine/web/react/api/generated/**\"",
    "typecheck": "npm run generate:api && tsc --noEmit",
    "generate:api": "orval --config orval.config.js",
    "generate:api:raw": "orval --config orval.config.js"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.15.1"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "orval": "8.14.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}
